<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layoutMainLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvFioStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        tools:text="student info"
        android:textSize="25sp"
        android:textColor="#00FFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btnCloseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="327dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/button_close_description"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFioStudent"
        tools:ignore="TouchTargetSizeCheck"/>

    <TextView
        android:id="@+id/tvMainWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:textSize='50sp'
        app:layout_constraintTop_toBottomOf="@id/btnCloseButton"
        tools:layout_editor_absoluteX="32dp"
        tools:text="Galaxy"
        android:fontFamily="@font/nunito_bold"/>

    <LinearLayout
        android:id="@+id/layoutVariants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvMainWord"
        tools:layout_editor_absoluteX="32dp">

        <LinearLayout
            android:id="@+id/layoutFirstVariant"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/shape_rounded_containers"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFirstNumberVariant"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:background="@drawable/shape_rounded_variants"
                android:gravity="center"
                android:text="@string/textview_first_variant"
                android:textColor="#888992"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_regular"/>

            <TextView
                android:id="@+id/tvFirstWordVariant"
                android:layout_width="235dp"
                android:layout_height="24sp"
                android:layout_margin="8dp"
                android:text="@string/textview_first_word"
                style="@style/VariantsStyle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSecondVariant"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_rounded_containers"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSecondNumberVariant"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:background="@drawable/shape_rounded_variants"
                android:gravity="center"
                android:text="@string/textview_second_variant"
                android:textColor="#888992"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_regular"/>

            <TextView
                android:id="@+id/tvSecondWordVariant"
                android:layout_width="235dp"
                android:layout_height="24sp"
                android:layout_margin="8dp"
                android:text="@string/textview_second_word"
                style="@style/VariantsStyle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutThirdVariant"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_rounded_containers"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvThirdNumberVariant"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:background="@drawable/shape_rounded_variants"
                android:gravity="center"
                android:text="@string/textview_third_variant"
                android:textColor="#888992"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_regular"/>

            <TextView
                android:id="@+id/tvThirdWordVariant"
                android:layout_width="235dp"
                android:layout_height="24sp"
                android:layout_margin="8dp"
                android:text="@string/textview_third_word"
                style="@style/VariantsStyle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFourthVariant"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_rounded_containers"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvForthNumberVariant"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:background="@drawable/shape_rounded_variants"
                android:gravity="center"
                android:text="@string/textview_fourth_variant"
                android:textColor="#888992"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_regular"/>

            <TextView
                android:id="@+id/tvFourthWordVariant"
                android:layout_width="235dp"
                android:layout_height="24sp"
                android:layout_margin="8dp"
                android:text="@string/textview_fourth_word"
                style="@style/VariantsStyle"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSkipButton"
        android:layout_width="310dp"
        android:layout_height="58dp"
        android:text="@string/button_skip"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:contentDescription="@string/button_skip_description"
        android:layout_marginBottom="30dp"
        android:backgroundTint="@color/buttonBlueColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="visible"/>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutInfoBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0EAD69"
        tools:layout_height="136dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivIconСorrect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="36dp"
            android:contentDescription="image of correct"
            android:src="@drawable/ic_thumb_correct"
            tools:layout_editor_absoluteX="40dp"
            tools:layout_editor_absoluteY="21dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />
        
        <TextView
            android:id="@+id/tvCorrectWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:text="@string/textview_correct_text"
            android:textSize="22sp"
            android:fontFamily="@font/rubic_regular"
            app:layout_constraintStart_toEndOf="@id/ivIconСorrect"
            app:layout_constraintTop_toTopOf="@id/ivIconСorrect"
            app:layout_constraintBottom_toBottomOf="@id/ivIconСorrect"/>

        <android.widget.Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="@string/button_continue"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:textColor="#0EAD69"
            android:fontFamily="@font/nunito_bold"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FFFFFF"
            android:background="@drawable/shape_rounded_button"
            app:layout_constraintTop_toBottomOf="@id/ivIconСorrect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>